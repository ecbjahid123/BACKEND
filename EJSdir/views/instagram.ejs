<!--Include:In Express.js,the term "include" usually refers to including reusable templating parts(like header,footer,navigation bars) in your main views when using a templating engine like EJS.-->
<%-include("includes/header.ejs")%>
<body>
    <h2>@<%=userData.name%></h2>
    <button>Follow</button>
    <button>Message</button>
    <p>Followers:<%=userData.followers%> &nbsp; &nbsp; &nbsp; Following:<%=userData.following%></p>
    <hr>
    <% for(let post of userData.posts){ %>
    <img src="<%=post.image%>" alt="cats Picture">
    <p>Likes:<%=post.likes%> &nbsp; &nbsp; &nbsp; Comments:<%=post.comments%></p>
    <% } %>
    <%-include("includes/footer.ejs")%>
</body>
<script src="/app.js"></script>
</html>