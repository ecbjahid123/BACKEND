<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini Whatsapp</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h1 class="allChats">All Chats</h1>
    <%for(let chat of chats){%>
        <div class="chat">
            <p>From: <i><%=chat.from%></i></p>
            <div class="msg">
                <p><%=chat.message%></p>
                <form  class="updateForm" action="http://localhost:8080/chats/<%=chat._id%>/update" method="GET">
                <button class="updateChat" type="submit">Update Chat</button>
            </form>
            </div>
            <p>received by <i><%=chat.to%></i></p>
            <hr>
            <p>Time:<%=chat.date.toString().split(" ")[4]%></p>
            <p>Date:<%=chat.date.toString().split(" ").slice(0,4).join(" ")%></p>
            <div class="buttons">
                <form  class="deleteForm" action="/chats/<%=chat._id%>?_method=DELETE" method="POST">
                 <button class="deleteChat" type="submit">Delete</button>
                 </form>
                <form  class="showForm" action="http://localhost:8080/chats/<%=chat._id%>" method="GET">
                <button class="showChat" type="submit">Show</button>
                </form>
            </div>
        </div>
    <%}%>
    <form  class="createForm" action="http://localhost:8080/chats/new" method="GET">
        <button class="createChat" type="submit">Create New Chat</button>
    </form>
</body>
</html>