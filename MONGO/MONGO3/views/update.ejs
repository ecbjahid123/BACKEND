<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update Chat</title>
</head>
<body>
    <div>
        <h1>Update Chat</h1>
        <h3>ID: <i><%=chat._id%></i></h3>
        <p>This message is from <b><%=chat.from%></b></p>
        <p>Send this message  to <b><%=chat.to%></b></p>
    </div>
    <form action="/chats/<%=chat._id%>?_method=PUT" method="POST">
    <label for="message">Message:</label> <br> <br>
    <textarea name="message" id="message"  rows="10" cols="70" placeholder="<%=chat.message%>"></textarea> <br>
    <button>Submit</button>
    </form>
</body>
</html>