<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Show Chat</title>
</head>
<body>
    <div>
        <h1>Show Chat</h1>
        <h3>ID: <i><%=chat._id%></i></h3>
        <p>This message is from <b><%=chat.from%></b></p>
        <p>Send this message  to <b><%=chat.to%></b></p>
        <p>Message: <b><%=chat.message%></b></p>
    </div>
    
</body>
</html>